# Hardening headers applied to every response served by Cloudflare Pages.
# Keeps the site privacy-respectful and limits what can be abused.
#
# geolocation=(self) in the Permissions-Policy below: the map's locate-me
# button needs the API. Same-origin only and still permission-prompted by the
# browser. What that does and does not buy is set out honestly in the PRIVACY
# note at "4. LOCATE ME" in index.html — read that, not a summary here. In
# short: the page keeps the coordinate in memory, but moving the map to it
# does cause tile requests, and those now go to /tiles/* on this origin
# instead of a third party. Cloudflare, who already serve every request, can
# still see them. The claim is "no NEW party learns it", not "nobody does".
#
# script-src/style-src are 'self' only. Leaflet and Chart.js are vendored
# under /vendor/ rather than loaded from unpkg/jsdelivr: CDN copies handed
# those hosts every visitor's IP, and an unpinned bundle running in this
# origin could have read a visitor's location once geolocation was enabled.
# (Comment kept OUTSIDE the rule block on purpose: an unrecognised line inside
# a /* block risks being read as the end of it, which would silently drop
# every header after it.)

# Strict-Transport-Security: every request here is already HTTPS, but without
# HSTS the FIRST one a reader ever makes can still be downgraded on a hostile
# network before the redirect lands. `preload` is deliberately absent — that
# submits the domain to a browser-baked list and is effectively irreversible.
# includeSubDomains covers the preview deployments (<hash>.baliair.pages.dev),
# which are HTTPS-only like everything else on Pages; if a plain-HTTP subdomain
# is ever added, this line has to be revisited before it is.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # 'unsafe-inline' is required: no build step, so the app is inline script.
  # Every other source is 'self' — no third-party origin can load here.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'

/api/*
  Cache-Control: public, max-age=60

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Pinned vendored copies of Leaflet and Chart.js. They change only when we
# deliberately replace the file, so there is no reason for a returning reader
# to revalidate ~500 KB of them on every page. Not `immutable` at a year like
# the fonts: these filenames are NOT content-hashed, so a swap has to become
# visible eventually — a week, then a conditional request.
/vendor/*
  Cache-Control: public, max-age=604800

# Translation dictionaries. id.json alone is 230 KB, it is fetched on every
# page load for anyone reading in Indonesian — the local audience, largely on
# mobile data — and it had NO cache policy at all, so every page cost the full
# download. An hour is short enough that a corrected string ships the same day
# and long enough to cover a reading session; a missing key falls back to the
# English in the HTML, so a briefly stale dictionary degrades to legible rather
# than to broken.
/i18n/*
  Cache-Control: public, max-age=3600
